    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@playwright/cli": "^0.1.19",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
